# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# ==========================================
# AI Provider Configuration (Choose ONE option)
# ==========================================
# OPTION 1: Groq Cloud (RECOMMENDED - 100% FREE, Ultra-Fast, No Credit Card needed)
# 1. Sign up at https://console.groq.com/keys (Log in with Google/GitHub)
# 2. Click "Create API Key" and paste below:
HF_API_URL=https://api.groq.com/openai/v1/chat/completions
HF_TOKEN=gsk_your_groq_api_key_here
HF_MODEL=llama-3.3-70b-versatile

# OPTION 2: OpenRouter (100% FREE Models, No Credit Card needed)
# 1. Sign up at https://openrouter.ai/keys
# 2. Click "Create Key" and paste below:
# HF_API_URL=https://openrouter.ai/api/v1/chat/completions
# HF_TOKEN=sk-or-v1-your_openrouter_key_here
# HF_MODEL=meta-llama/llama-3.2-3b-instruct:free

# OPTION 3: Hugging Face (Requires pre-paid credits on router.huggingface.co)
# HF_API_URL=https://router.huggingface.co/v1/chat/completions
# HF_TOKEN=hf_your_token_here
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Generate with: openssl rand -base64 48
JWT_SECRET=<long-random-string-min-32-chars>

ALLOWED_ORIGINS=http://localhost:5173

# MongoDB Atlas URI
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Redis URL
SPRING_DATA_REDIS_URL=redis://default:<password>@<host>:<port>

SERVER_PORT=8080
