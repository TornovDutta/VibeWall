# Groq API Key (get free at https://console.groq.com/keys)
GROQ_APIKEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Generate with: openssl rand -base64 48
JWT_SECRET=<long-random-string-min-32-chars>

ALLOWED_ORIGINS=http://localhost:5173

# MongoDB Atlas URI
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Redis URL
SPRING_DATA_REDIS_URL=redis://default:<password>@<host>:<port>

SERVER_PORT=8080
